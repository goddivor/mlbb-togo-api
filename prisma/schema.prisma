
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  username       String    @unique
  email          String    @unique
  password       String
  avatar         String?
  rank           String    @default("warrior")
  role           String    @default("fighter")
  favoriteHeroes String    @default("[]")
  wins           Int       @default(0)
  losses         Int       @default(0)
  mvpCount       Int       @default(0)
  streak         Int       @default(0)
  country        String    @default("Togo")
  city           String?
  bio            String?
  badges         String    @default("[]")
  joinedAt       DateTime  @default(now())
  lastActive     DateTime  @default(now())
  isOnline       Boolean   @default(false)
  isBanned       Boolean   @default(false)
  roleUser       String    @default("user")
  // RBAC (#rbac): ids of the Role documents held by the user. `roleUser` is
  // kept in sync (derived) for backward compatibility.
  roleIds        String[]  @db.ObjectId
  // Dedicated technical account (e.g. the bootstrap `admin` created by
  // prisma/create-admin.js): hidden from every player-facing feature.
  isSystemAccount Boolean  @default(false)

  provider       String    @default("local")

  googleId       String?
  googleEmail    String?
  googleName     String?
  googleAvatar   String?

  mlbbRoleId     Int?
  mlbbZoneId     Int?
  mlbbToken      String?
  gameNickname   String?
  gameAvatar     String?
  gameLevel      Int?
  gameRankLevel  Int?
  gamePeakRankLevel Int?
  gameCountry    String?
  gameStats      String    @default("{}")
  gameFrequentHeroes String @default("[]")
  gameRoles      String    @default("[]")
  gameSeasons    String    @default("[]")
  gameSyncedAt   DateTime?
  // Health of the stored Moonton session and of the last game sync. Stored
  // game data is never wiped when a sync fails: these fields tell the UI why
  // it may be stale. mlbbTokenStatus: valid | expired.
  // gameSyncStatus: ok | moonton_offline | token_expired | unavailable.
  mlbbTokenStatus    String?
  mlbbTokenExpiredAt DateTime?
  gameSyncStatus     String?
  gameSyncMessage    String?
  gameSyncAttemptAt  DateTime?
  gameStatsSyncedAt  DateTime?

  profileSource  String    @default("game")

  // Rewards (#122): equipped avatar frame (`frameId` or `frameId:variant`),
  // last permanent frame equipped (restored when a temporary one expires),
  // expiry of the equipped frame (denormalized so every avatar payload can
  // resolve the frame without a join) and equipped level title.
  equippedFrame          String?
  fallbackFrame          String?
  equippedFrameExpiresAt DateTime?
  equippedTitle          String?

  // User preferences (settings page).
  notifPrefs     Json?
  privacy        Json?
  teamId         String?   @db.ObjectId
  team           Team?     @relation("TeamMembers", fields: [teamId], references: [id])
  posts          Post[]
  comments       Comment[]
  esportMemberships EsportTeamMember[] @relation("EsportMemberships")
  pickbanDrafts  PickBanDraft[] @relation("PickBanDrafts")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Team {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  tag          String
  logo         String?
  description  String?
  captainId    String?
  members      User[]   @relation("TeamMembers")
  maxMembers   Int      @default(7)
  wins         Int      @default(0)
  losses       Int      @default(0)
  rank         Int      @default(0)
  foundedAt    DateTime @default(now())
  region       String   @default("Togo")
  achievements String   @default("[]")
  isRecruiting Boolean  @default(false)
  lookingFor   String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  authorId   String    @db.ObjectId
  author     User?     @relation(fields: [authorId], references: [id])
  authorName String
  authorRank String?
  category   String
  title      String
  content    String
  likes      Int       @default(0)
  views      Int       @default(0)
  isPinned   Boolean   @default(false)
  comments   Comment[]
  // Communication feed (issue #49): share counter, rich content and sponsoring.
  shares        Int        @default(0)
  contentFormat String     @default("text")
  images        String     @default("[]")
  isSponsored   Boolean    @default(false)
  sponsorId     String?    @db.ObjectId
  postLikes     PostLike[]
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

// One row per (post, user) like so the like action is an idempotent toggle.
// `Post.likes` is kept in sync as a denormalized counter.
model PostLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  postId    String   @db.ObjectId
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  postId     String   @db.ObjectId
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId   String   @db.ObjectId
  author     User?    @relation(fields: [authorId], references: [id])
  authorName String
  content    String
  createdAt  DateTime @default(now())
}

model Tournament {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  name            String
  description     String?
  organizer       String?
  status          String   @default("upcoming")
  startDate       String?
  endDate         String?
  prizePool       String?
  maxTeams        Int      @default(16)
  registeredTeams String   @default("[]")
  format          String?
  rules           String?
  banner          String?
  brackets        String   @default("[]")
  streamUrl       String?
  mvpUserId       String?  @db.ObjectId
  // Host city (Togo map, issue #70). Free text normalized by src/geo.
  city            String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Event {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  title        String
  type         String
  description  String?
  date         String?
  time         String?
  duration     String?
  participants String   @default("[]")
  organizer    String?
  isPublic     Boolean  @default(true)
  // Host city (Togo map, issue #70).
  city         String?
  createdAt    DateTime @default(now())
}

model Match {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  team1      String
  team2      String
  tournament String?
  date       String?
  status     String   @default("upcoming")
  mvp        String?
  duration   String?
  format     String?
  games      String   @default("[]")
  createdAt  DateTime @default(now())
}

model Hero {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  role        String
  image       String?
  description String?

  // Cache of MLBB data (avoids calling the API on every display).
  // Optional fields/arrays: safe for reading existing documents.
  heroId      Int?
  roles       String[] // playable classes (assassin, mage, fighter...)
  laneKeys    String[] // recommended lanes (gold/exp/jungle/mid/roam)
  art         String?  // splash art
  thumb       String?  // thumbnail
  stats       Json? // win/pick/ban and meta (MLBB cache)
  speciality  String[]
  source      String? // "seed" | "mlbb"
  syncedAt    DateTime?

  createdAt   DateTime @default(now())
}

// The 5 MLBB lanes. Few rows, but the description and icon (SVG)
// are editable by the admin (useful when Moonton reworks the game).
// `compatibleClasses` encodes which classes can hold the lane, without
// contradiction (e.g. jungle = assassin + fighter, roam = tank + support).
model Lane {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  key               String   @unique // gold | exp | jungle | mid | roam
  name              String // "Gold Lane"
  shortName         String? // "Gold"
  description       String
  icon              String // SVG URL
  color             String?
  compatibleClasses String[] // classes playable on this lane
  sort              Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// ---- Game Items (edited by admin) ----
model Item {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  icon        String?  // URL to item icon
  type        String?  // e.g. "defense", "attack", "attack_speed", "mana", "cooldown"
  gold        Int?     // cost in gold
  gameId      Int?      // Moonton GMS id, set by the catalog sync (partial unique index)
  syncedAt    DateTime? // last write by the catalog sync (later edits are kept)
  enabled     Boolean?  @default(true) // false = hidden from players and pickers (null/missing = enabled)
  stats       String?   // item attributes text from Moonton ("+160 Extra Physical Attack\n...")
  passive     String?   // item passive / unique skills text from Moonton
  gameMeta    String?   // JSON: { categoryId, category, isComponent, tier, buildsFrom, buildsInto } (Moonton ids)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Emblems (edited by admin) ----
model Emblem {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  icon        String?  // URL to emblem icon
  type        String?  // e.g. "support", "order", "chaos"
  gameId      Int?      // Moonton GMS id, set by the catalog sync (partial unique index)
  syncedAt    DateTime? // last write by the catalog sync (later edits are kept)
  enabled     Boolean?  @default(true) // false = hidden from players and pickers (null/missing = enabled)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Battle Spells (edited by admin) ----
model BattleSpell {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  icon        String?  // URL to battle spell icon
  cooldown    String?  // e.g. "60s"
  gameId      Int?      // Moonton GMS id, set by the catalog sync (partial unique index)
  syncedAt    DateTime? // last write by the catalog sync (later edits are kept)
  enabled     Boolean?  @default(true) // false = hidden from players and pickers (null/missing = enabled)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---- Hero Builds (recommended by admin per hero) ----
model HeroBuild {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  heroId        String   @db.ObjectId
  heroName      String   // denormalized for convenience (hero.name at creation time)
  name          String?  // e.g. "Recommended", "Offlane", "Burst"
  description   String?
  itemIds       String[] // array of Item IDs in order
  emblemId      String?  @db.ObjectId // single emblem per build
  battleSpellId String?  @db.ObjectId // single battle spell per build
  priority      Int      @default(0)  // higher = higher priority (displayed first)
  sort          Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ---- Emblem talents (#129), imported by the catalog sync (Academy 2718121) ----
// Three tiers: tier 1 and 2 are standard talents, tier 3 is the core talent.
// A community build picks at most one talent per tier.
model EmblemTalent {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  description String?
  icon        String?
  tier        Int?      // 1 | 2 | 3 (Moonton `gifttiers`)
  gameId      Int?      // Moonton gift id (partial unique index)
  syncedAt    DateTime?
  enabled     Boolean?  @default(true) // false = hidden from pickers (null/missing = enabled)
  sort        Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ---- Community builds (#129): hero builds created by players ----
// Admin-curated builds stay in HeroBuild ("recommended by MLBB Togo").
model CommunityBuild {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  authorId      String    @db.ObjectId
  heroId        String    @db.ObjectId // Hero document id
  heroGameId    Int?      // Moonton hero id (the hero modal addresses heroes with it)
  heroName      String
  title         String
  notes         String?
  lane          String?   // gold | exp | jungle | mid | roam
  itemIds       String[]  // Item ids, in purchase order (max 6)
  emblemId      String?   @db.ObjectId
  talentIds     String[]  // EmblemTalent ids (max one per tier)
  battleSpellId String?   @db.ObjectId
  // draft (author only) | published (public) | hidden (removed by a moderator)
  status        String    @default("draft")
  likesCount    Int       @default(0)
  reportsCount  Int       @default(0) // open reports
  publishedAt   DateTime?
  hiddenAt      DateTime?
  hiddenById    String?   @db.ObjectId
  hiddenReason  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status, heroId])
  @@index([authorId])
}

// Quota counters of the community builds (#129). One document per window:
// `publish:<userId>:<UTC day>`, `report:<userId>:<UTC day>` (ledgers that
// survive deleting builds or reports) and `builds:<userId>` (builds owned,
// decremented on deletion). Incremented atomically under the cap.
model CommunityBuildQuota {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  userId    String   @db.ObjectId
  kind      String   // publish | report | builds
  count     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CommunityBuildLike {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  buildId   String   @db.ObjectId
  userId    String   @db.ObjectId
  createdAt DateTime @default(now())

  @@unique([buildId, userId])
  @@index([userId])
}

model CommunityBuildReport {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  buildId      String    @db.ObjectId
  reporterId   String    @db.ObjectId
  reason       String    // spam | offensive | misleading | other
  details      String?
  status       String    @default("open") // open | resolved | dismissed
  resolvedById String?   @db.ObjectId
  resolvedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@unique([buildId, reporterId])
  @@index([status])
  @@index([reporterId, createdAt])
}

model AdminLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  action    String
  admin     String
  target    String?
  details   String?
  timestamp DateTime @default(now())
}

model FormTemplate {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  description String?
  fields      String         @default("[]")
  status      String         @default("active")
  responses   FormResponse[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FormResponse {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  formId      String       @db.ObjectId
  form        FormTemplate @relation(fields: [formId], references: [id], onDelete: Cascade)
  data        String       @default("{}")
  submittedAt DateTime     @default(now())
}

model HeroRole {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  name      String
  icon      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PushSubscription {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  type      String
  title     String
  message   String
  // Structured params (actor name, team name, status…) so the client can
  // render a localized string; title/message stay as a plain-text fallback.
  data      Json?
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
}

model Esport {
  id          String       @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  logo        String?
  color       String?
  description String?
  // JSON object of public target figures shown on the About page
  // ({ streamAudience, socialReach, teams, offlineEvents }), edited by the admin.
  figures     String?
  teams       EsportTeam[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model EsportTeam {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  image        String?
  description  String?
  type         String             @default("community")
  esportId     String?            @db.ObjectId
  esport       Esport?            @relation(fields: [esportId], references: [id], onDelete: Cascade)
  members      EsportTeamMember[]
  staff        EsportTeamStaff[]
  // JSON array of manual honours (titles/placements) edited by the admin.
  honours      String?
  // Home city (Togo map, issue #70).
  city         String?
  sort         Int                @default(0)
  foundedAt    DateTime           @default(now())
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model EsportTeamMember {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  teamId       String     @db.ObjectId
  team         EsportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId       String     @db.ObjectId
  user         User       @relation("EsportMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role         String?
  isCaptain    Boolean    @default(false)
  isSubstitute Boolean    @default(false)
  sort         Int        @default(0)
  joinedAt     DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([teamId, userId])
}

// Partner / sponsor. `tier` ranks the partnership (title | gold | silver |
// partner), `seasonIds` links it to the league seasons it sponsors (empty =
// every season), `isActive` hides it from public pages without deleting it.
model Sponsor {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String?
  logo        String
  url         String?
  sort        Int      @default(0)
  tier        String?
  description String?
  seasonIds   String[] @default([])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// Sponsoring package shown on the public "Become a sponsor" page.
// `benefits` is a JSON array of strings.
model SponsorOffer {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  tier       String?
  priceLabel String?
  benefits   String   @default("[]")
  highlight  Boolean  @default(false)
  isActive   Boolean  @default(true)
  sort       Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Partnership request sent from the public sponsoring form.
// Lifecycle: new -> contacted -> accepted | declined.
model SponsorshipRequest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  company     String
  contactName String
  email       String
  phone       String?
  message     String
  offerId     String?  @db.ObjectId
  status      String   @default("new")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Season distinctions (#46): MVP, best player per lane and custom awards.
// The fixed categories are unique per season (partial index, see
// prisma/mongo-indexes.js); `criteria` is a JSON snapshot of the stats used.
model SeasonAward {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  seasonId    String   @db.ObjectId
  category    String   // mvp | best_gold | best_mid | best_jungle | best_roam | best_exp | custom
  title       String?  // label of a custom award
  userId      String?  @db.ObjectId
  teamId      String?  @db.ObjectId
  description String?
  imageUrl    String?
  criteria    String?  // JSON: stats snapshot (games, kda, mvpCount, ...)
  sort        Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([seasonId])
}

// Non-playing staff attached to a team (coach, manager, analyst...).
// `userId` optionally links the staff entry to a platform account.
model EsportTeamStaff {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  teamId    String     @db.ObjectId
  team      EsportTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String?    @db.ObjectId
  name      String
  role      String     @default("coach")
  avatar    String?
  bio       String?
  sort      Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([teamId])
}

// League season. `isActive` is kept in sync with `status` for backward
// compatibility (status === 'active' || 'playoffs' <=> isActive).
// Lifecycle: upcoming -> active -> playoffs -> closed (reopen goes back to
// active). `summary` is a JSON snapshot frozen at closing (final standings,
// podium) read by the Hall of Fame. `slug` is unique through a partial index
// (see prisma/mongo-indexes.js) so legacy documents without a slug stay valid.
model EsportSeason {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  name              String
  slug              String?
  number            Int?
  theme             String?
  slogan            String?
  description       String?
  status            String?   // upcoming | active | playoffs | closed
  startDate         DateTime?
  endDate           DateTime?
  playoffsStartDate DateTime?
  closedAt          DateTime?
  banner            String?
  color             String?
  summary           String?   // JSON snapshot frozen at closing
  settings          String?   // JSON: standings settings (points, qualifyTop)
  // JSON: manual podium overrides { regular: [{placement, teamId}] | null, playoffs: [...] | null } (#46)
  podiums           String?
  isActive          Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model EsportMatch {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  seasonId     String?   @db.ObjectId
  type         String    @default("friendly")
  teamAId      String    @db.ObjectId
  teamBId      String    @db.ObjectId
  scheduledAt  DateTime?
  status       String    @default("scheduled")
  scoreA       Int       @default(0)
  scoreB       Int       @default(0)
  winnerTeamId String?   @db.ObjectId
  notes        String?
  // Competition stage: scrim | league | playoff. Legacy rows (null) derive it
  // from `type` (friendly/training -> scrim, official -> league).
  stage        String?
  // Series format: bo1 | bo3 | bo5 | bo7.
  format       String?
  // JSON array of per-game details ({ winnerTeamId, duration, mvpUserId, screenshot }).
  games        String?
  // JSON array of screenshot URLs (max 10).
  screenshots  String?
  vodUrl       String?
  streamUrl    String?
  // Match MVP (mirrors the `isMvp` flag of EsportMatchPlayer when stats exist).
  mvpUserId    String?   @db.ObjectId
  createdById  String?   @db.ObjectId
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Per-player participation and stats on an esport match (one row per
// player and match). Used to build player profiles: history, win rate,
// KDA, MVP count, badges. Additive model: existing matches simply have
// no rows.
model EsportMatchPlayer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  matchId   String   @db.ObjectId
  userId    String   @db.ObjectId
  teamId    String   @db.ObjectId
  hero      String?  // hero name from the catalog
  heroId    String?  @db.ObjectId // catalog Hero id (optional)
  role      String?  // roam | jungle | mid | exp | gold
  kills     Int      @default(0)
  deaths    Int      @default(0)
  assists   Int      @default(0)
  gold      Int?
  damage    Int?
  isMvp     Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@index([userId])
}

type RecruitmentSlot {
  role     String
  quantity Int    @default(1)
}

model Recruitment {
  id          String             @id @default(auto()) @map("_id") @db.ObjectId
  teamId      String             @db.ObjectId
  createdById String             @db.ObjectId
  status      String             @default("open")
  message     String?
  slots       RecruitmentSlot[]
  // Requirements advertised by the campaign, used by the advanced filters.
  // minRankLevel is an in-game rank level (see decodeRank in users.service);
  // null means the campaign accepts every rank.
  minRankLevel Int?
  // Expected commitment: casual | regular | competitive. Null = no expectation.
  availability String?
  openedAt    DateTime           @default(now())
  closedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model RecruitmentApplication {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  recruitmentId String   @db.ObjectId
  teamId        String   @db.ObjectId
  userId        String   @db.ObjectId
  role          String?
  message       String?
  // pending | shortlisted | accepted | rejected | withdrawn
  status        String   @default("pending")
  // Candidate-declared availability: casual | regular | competitive.
  availability  String?
  // Rank level snapshot taken when the application was submitted, so that
  // filtering a shortlist stays stable even if the player ranks up later.
  rankLevel     Int?
  // Audit trail of the last status change.
  decidedById   String?  @db.ObjectId
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Friendship {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  requesterId String   @db.ObjectId
  addresseeId String   @db.ObjectId
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TeamRequest {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  requesterId   String   @db.ObjectId
  proposedName  String
  message       String?
  status        String   @default("pending")
  createdTeamId String?  @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MessageThread {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  subject        String?
  requestId      String?  @db.ObjectId
  participantIds String[]
  // Group rooms: "direct" (1-1, participantIds) | "team" (esport roster) |
  // "tournament" (registered teams / draft registrations) | "draft_team".
  // Membership of group kinds is derived from the scope, never stored.
  kind           String   @default("direct")
  scopeId        String?
  title          String?
  avatar         String?
  lastMessageAt  DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// Per-user read cursor for group rooms (Message.readAt only fits 1-1 chats).
model ThreadRead {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  threadId   String   @db.ObjectId
  userId     String   @db.ObjectId
  lastReadAt DateTime @default(now())

  @@unique([threadId, userId])
}

model Message {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  threadId  String    @db.ObjectId
  senderId  String    @db.ObjectId
  body      String
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

model Mtl {
  id          String     @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  season      String?
  description String?
  startDate   String?
  endDate     String?
  images      MtlImage[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model MtlImage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  image     String
  caption   String?
  sort      Int      @default(0)
  mtlId     String   @db.ObjectId
  mtl       Mtl      @relation(fields: [mtlId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String?
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model StreamConfig {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  youtubeChannel String   @default("eternumesports")
  channelId      String   @default("")
  channelTitle   String   @default("")
  channelAvatar  String   @default("")
  channelBanner  String   @default("")
  liveTitle      String   @default("")
  liveDesc       String   @default("")
  s1MainVideoId  String   @default("")
  videos         String   @default("[]")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StreamSeasonVideo {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  seasonId  String   @db.ObjectId
  videoId   String
  title     String   @default("")
  thumbnail String   @default("")
  duration  String   @default("")
  date      String   @default("")
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([seasonId, videoId])
}

model YoutubeAccount {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  channelId        String   @unique
  channelTitle     String   @default("")
  channelThumbnail String   @default("")
  channelBanner    String   @default("")
  accessToken      String
  refreshToken     String
  tokenExpiresAt   DateTime
  scope            String   @default("")
  isConnected      Boolean  @default(true)
  connectedAt      DateTime @default(now())
  liveBroadcastId  String   @default("")
  liveStreamId     String   @default("")
  liveRtmpUrl      String   @default("")
  liveStreamKey    String   @default("")
  liveStatus       String   @default("")
  liveWatchUrl     String   @default("")
  liveTitle        String   @default("")
  updatedAt        DateTime @updatedAt
}

// ---- Draft Simulator (community tournaments 1v1 / 3v3 / 5v5) ----
model DraftTournament {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  name                 String
  description          String?
  category             String    // "1v1" | "3v3" | "5v5"
  teamSize             Int       // 1 | 3 | 5
  roles                String    @default("[]") // JSON: required roles (admin-defined for non-5v5; the 5 lanes for 5v5)
  status               String    @default("draft") // draft | registration | closed | drafted | ongoing | completed
  registrationOpensAt  DateTime?
  registrationClosesAt DateTime?
  secondPhaseOpen      Boolean   @default(false)
  secondPhaseClosesAt  DateTime?
  createdById          String?   @db.ObjectId
  // Host city (Togo map, issue #70).
  city                 String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
}

model DraftRegistration {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId  String   @db.ObjectId
  userId        String   @db.ObjectId
  preferredRole String
  phase         Int      @default(1) // 1 = initial, 2 = second registration phase
  createdAt     DateTime @default(now())

  @@unique([tournamentId, userId])
}

model DraftTeam {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String   @db.ObjectId
  name         String
  icon         String   @default("")
  seed         Int      @default(0)
  complete     Boolean  @default(true)
  eliminated   Boolean  @default(false) // incomplete team kept out of the bracket
  createdAt    DateTime @default(now())
}

model DraftTeamMember {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId  String @db.ObjectId
  teamId        String @db.ObjectId
  userId        String @db.ObjectId
  preferredRole String
  assignedRole  String
}

model DraftMatch {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  tournamentId String    @db.ObjectId
  round        Int
  position     Int
  teamAId      String?   @db.ObjectId
  teamBId      String?   @db.ObjectId
  winnerTeamId String?   @db.ObjectId
  scheduledAt  DateTime?
  status       String    @default("pending") // pending | done
  createdAt    DateTime  @default(now())
}

// ----- Gamification (XP, levels, achievements, missions) -----
// Additive models: users without rows simply have no progress yet.

model UserProgress {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  xp        Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per XP grant. The [userId, type, refId] unique index makes every
// grant idempotent (re-submitting a match result never double counts).
model XpEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  type      String
  amount    Int
  refId     String
  // Short snapshot of the source (e.g. admin correction reason and author).
  meta      Json?
  createdAt DateTime @default(now())

  @@unique([userId, type, refId])
  @@index([userId, createdAt])
  // Platform-wide lookups: game account link, event rewards, elections, event candidates.
  @@index([type, refId])
  @@index([type, createdAt])
}

// Atomic per-period counters of the XP guard-rails (daily / weekly / monthly
// caps, daily social XP): one document per (user, key), incremented with $inc
// so concurrent grants can never exceed a cap (rewards #125).
model XpCounter {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  // cap:<type>:<period> | social:<day>
  key       String
  value     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model UserAchievement {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  userId        String   @db.ObjectId
  achievementId String
  unlockedAt    DateTime @default(now())

  @@unique([userId, achievementId])
}

// Progress of a user on a mission for a given period (day or ISO week).
model UserMission {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  userId      String    @db.ObjectId
  missionId   String
  periodKey   String
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, missionId, periodKey])
  @@index([userId, periodKey])
}

model PickBanDraft {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @default("Untitled Draft")
  mode        String    @default("ranked") // ranked | tournament
  shareCode   String    @unique @db.String
  ownerId     String    @db.ObjectId
  owner       User?     @relation("PickBanDrafts", fields: [ownerId], references: [id])

  // Teams: JSON-serialized arrays of picks/bans
  blueTeam    String    @default("{\"picks\":[],\"bans\":[]}") // Pick[], Ban[]
  redTeam     String    @default("{\"picks\":[],\"bans\":[]}") // Pick[], Ban[]

  // Draft state
  currentStep Int       @default(0) // step in the MLBB draft order
  status      String    @default("active") // active | completed | archived

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}


// ---------------------------------------------------------------------------
// Game account data (Moonton), cached so anyone can read it without calling
// Moonton. Filled by the game sync with the owner's session; never deleted on
// a failed sync (only on unlink / account deletion).

/// Per-season aggregates of a linked game account.
model GameSeasonStats {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  sid            Int
  // JSON array of frequent heroes: { heroId, name, image, matches, wins, winRate, power }.
  frequentHeroes String   @default("[]")
  syncedAt       DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, sid])
}

/// One match of a linked game account (battle report summary + optional detail).
model GameMatch {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  userId         String    @db.ObjectId
  // Moonton battle id as a string (the number overflows JS precision).
  bid            String
  sid            Int
  heroId         Int
  heroName       String?
  heroImage      String?
  kills          Int       @default(0)
  deaths         Int       @default(0)
  assists        Int       @default(0)
  laneId         Int?
  score          Float     @default(0)
  mvp            Boolean   @default(false)
  win            Boolean   @default(false)
  playedAt       DateTime
  durationSec    Int?
  // JSON match detail (10-player scoreboard), null until fetched.
  detail         String?
  detailSyncedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([userId, bid])
  @@index([userId, sid, playedAt])
  @@index([userId, heroId])
}

// Cache of Moonton GMS hero statistics (rankings, matchups, builds...), keyed by
// request signature. Written by MetaCacheService (stale-while-revalidate), so
// pages never wait on Moonton when a copy exists. Safe to purge at any time.
model MlbbCache {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String // JSON payload
  fetchedAt DateTime
  expiresAt DateTime
}

// RBAC role: a named set of permission keys (see src/access/permissions.ts).
// `systemKey` identifies built-in roles ("admin" = Administrateur, all
// permissions, locked; "moderator" = seeded Modérateur, editable).
model Role {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String   @unique
  description String?
  permissions String[]
  isSystem    Boolean  @default(false)
  systemKey   String?
  color       String   @default("#6366f1")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ----- Rewards (#122): avatar frames, elections, event windows -----

// One row per (user, frame, variant). A new grant reactivates or extends the
// same row (new period in `history`, `timesGranted + 1`).
model UserFrame {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  frameId      String
  variant      String    @default("")
  // level | achievement | award | admin | event | ranking
  source       String
  sourceRef    String?
  grantedById  String?   @db.ObjectId
  unlockedAt   DateTime  @default(now())
  expiresAt    DateTime?
  expiredAt    DateTime?
  timesGranted Int       @default(1)
  // Ownership periods: [{ from, to }] (`to` null while open-ended).
  history      Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, frameId, variant])
  @@index([frameId])
  @@index([expiresAt])
}

// Admin-managed event windows (CRUD and evaluation come with lot A2).
model RewardEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  slug        String   @unique
  name        String
  description String?
  startsAt    DateTime
  endsAt      DateTime
  // none | yearly
  recurrence  String   @default("none")
  conditions  Json?
  rewards     Json?
  // draft | scheduled | active | closed
  status      String   @default("draft")
  createdById String?  @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status, endsAt])
}

// Idempotency of the weekly MVP / monthly number one elections.
model RewardElection {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  // mvp_week | number_one_month
  kind      String
  // 2026-W38 | 2026-09
  period    String
  userId    String?  @db.ObjectId
  // auto | admin
  source    String   @default("auto")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, period])
}

// Runtime application setting managed from the admin (third-party integration
// credentials...). `value` is an AES-encrypted JSON document (see
// src/integrations): secrets never leave the API in clear text.
model AppSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       String
  updatedById String?  @db.ObjectId
  updatedAt   DateTime @updatedAt
}

// Image uploaded to Cloudinary through a signed direct upload (#131). Only the
// assets tracked here are ever destroyed on Cloudinary (never seed / MLBB CDN
// URLs). `purpose` + `targetType`/`targetId` tell where the image is used;
// `targetId` is null while the target does not exist yet (create forms).
// Community team images uploaded by a captain stay `pending` (the public keeps
// seeing the previous image) until an admin approves or rejects them.
model MediaAsset {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  publicId     String    @unique
  url          String    // delivered URL (with size / format transformations)
  secureUrl    String    // original Cloudinary URL
  purpose      String
  targetType   String
  targetId     String?
  uploadedById String    @db.ObjectId
  status       String    @default("approved") // signed | pending | approved | rejected
  bytes        Int
  width        Int
  height       Int
  format       String
  reviewedById String?   @db.ObjectId
  reviewedAt   DateTime?
  rejectReason String?
  // Set once the Cloudinary asset was destroyed (rejected rows are kept).
  destroyedAt  DateTime?
  // `signed` rows only: once past, the never confirmed upload is swept by the daily cron.
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([purpose, status])
  @@index([status, expiresAt])
  @@index([targetType, targetId])
  @@index([uploadedById])
}
